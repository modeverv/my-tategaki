(ert-deftest tategaki-rich-gui-hanging-punctuation-has-a-visible-caret ()
  (dolist (mark '("、" "。" "，" "．"))
    (dolist (gap '(0 20))
      (tategaki-rich-gui--with-text (concat "漢字" mark "漢字")
        (setq-local tategaki-column-height 2 tategaki-character-spacing gap)
        (tategaki-refresh)
        (let* ((body (tategaki-rich-gui--image-data (tategaki-rich-gui--caret)))
               (normal-text
                (with-temp-buffer
                  (insert body)
                  (car (dom-by-tag (car (xml-parse-region (point-min) (point-max))) 'text)))))
          (goto-char 3)
          (should (plist-get (aref (tategaki--entry (point)) 4) :hanging))
          (let* ((object (tategaki-rich-gui--caret))
                 (svg (tategaki-rich-gui--image-data object))
                 (mark-text
                  (with-temp-buffer
                    (insert svg)
                    (car (dom-by-tag (car (xml-parse-region (point-min) (point-max))) 'text))))
                 (geometry (tategaki-typeset-view-geometry (selected-window) tategaki--metrics))
                 (expected-height (round (/ (float (plist-get geometry :row-height)) 2))))
            ;; Half-cell advance must not mean half-sized punctuation.
            (should (equal (dom-attr mark-text 'font-size) (dom-attr normal-text 'font-size)))
            (should (= (get-text-property (cdr object) 'tategaki-unit-height (car object))
                       expected-height))
            (should (> (plist-get (tategaki-position-pixel (point)) :height) 1))))
        (should (equal (buffer-string) (concat "漢字" mark "漢字")))
        (should-not (buffer-modified-p))))))

(ert-deftest tategaki-rich-gui-fixed-pages-spread-grid-and-navigation ()
  (tategaki-rich-gui--with-text (make-string 1300 ?字)
    (setq-local tategaki-manuscript-fit-window t)
    (dolist (spec '(("20x20" 20 20 401) ("40x30" 40 30 1201)))
      (goto-char (point-min))
      (tategaki-manuscript-set-preset (nth 0 spec))
      (setq-local tategaki-manuscript-grid t tategaki-manuscript-spread nil)
      (tategaki-refresh)
      (should (= (plist-get tategaki--layout :height) (nth 1 spec)))
      (should (= tategaki--page-size (nth 2 spec)))
      (let* ((object (tategaki-rich-gui--caret))
             (svg (tategaki-rich-gui--image-data object)))
        (should (string-match-p "stroke=" svg)))
      ;; A whole paper must actually fit.  Image and spacer baselines may
      ;; otherwise enlarge each physical scanline despite correct geometry.
      (let* ((geometry (tategaki-typeset-view-geometry (selected-window)
                                                     tategaki--metrics))
             (pitch (plist-get geometry :row-pitch))
             (top (plist-get (tategaki-position-pixel 1) :y)))
        (dolist (row (list 2 (nth 1 spec)))
          (goto-char row)
          (tategaki-rich-gui--caret)
          (let ((pixel (tategaki-position-pixel (point))))
            (should (= (plist-get pixel :y) (+ top (* (1- row) pitch))))
            (should (<= (+ (plist-get pixel :y) (plist-get pixel :height))
                        (window-body-height nil t))))))
      (tategaki-goto-page 2)
      (should (= (point) (nth 3 spec)))
      (should (= (plist-get (tategaki-manuscript-page-info tategaki--layout (point)) :current) 2))
      (tategaki-rich-gui--caret)
      (tategaki-manuscript-toggle-spread)
      (should (= tategaki--page-size (* 2 (nth 2 spec))))
      (tategaki-rich-gui--caret))
    (should-not (buffer-modified-p))))

(ert-deftest tategaki-rich-gui-paper-zoom-preserves-size-with-partial-viewport ()
  (let ((width (frame-width)) (height (frame-height)))
    (unwind-protect
        (progn
          (set-frame-size nil 80 40)
          (tategaki-rich-gui--with-text (make-string 1700 ?字)
            (setq-local tategaki-manuscript-size '(20 . 20)
                        tategaki-manuscript-spread t tategaki-manuscript-grid t
                        tategaki-manuscript-fit-window nil)
            (let ((text (buffer-string)) (undo buffer-undo-list)
                  (tick (buffer-chars-modified-tick)) small large fonts)
              (dolist (amount '(-3 0))
                (tategaki-text-scale-reset)
                (tategaki-text-scale-increase amount)
                (goto-char 1)
                (let* ((object (tategaki-rich-gui--caret))
                       (svg (tategaki-rich-gui--image-data object))
                       (geometry (tategaki-typeset-view-geometry (selected-window) tategaki--metrics))
                       (font-size
                        (with-temp-buffer
                          (insert svg)
                          (string-to-number
                           (dom-attr (car (dom-by-tag (car (xml-parse-region (point-min) (point-max)))
                                                     'text)) 'font-size)))))
                  (if (= amount -3) (setq small geometry) (setq large geometry))
                  (push font-size fonts)
                  (should (string-match-p "stroke=" svg))
                  (should (= (plist-get tategaki--layout :height) 20))
                  (should (= (tategaki-manuscript--columns-per-page) 20))))
              (should (> (plist-get large :body) (plist-get small :body)))
              (should (> (car fonts) (cadr fonts)))
              (should (< (plist-get large :capacity) (plist-get small :capacity)))
              (should (< (plist-get large :capacity) 40))
              (message "Partial paper zoom -3→0: body %s→%s, SVG font %s→%s, columns %s→%s"
                       (plist-get small :body) (plist-get large :body) (cadr fonts) (car fonts)
                       (plist-get small :capacity) (plist-get large :capacity))
              ;; Begin inside a sheet, so the paper gap must follow absolute
              ;; columns 19/20 and 39/40, not the viewport's own midpoint.
              (dolist (first '(17 37))
                (tategaki-scroll-to-column first)
                (tategaki-rich-gui--caret)
                (should (= tategaki--page first))
                (let* ((boundary (* 20 (1+ (/ first 20))))
                       (before (tategaki-position-pixel (1+ (* 20 (1- boundary)))))
                       (after (tategaki-position-pixel (1+ (* 20 boundary))))
                       (same (tategaki-position-pixel (1+ (* 20 (1- (1- boundary)))))))
                  (should before) (should after) (should same)
                  (should (= (- (plist-get same :x) (plist-get before :x))
                             (plist-get large :pitch)))
                  (should (= (- (plist-get before :x) (plist-get after :x))
                             (+ (plist-get large :pitch) (plist-get large :paper-gap)))))
                ;; Click several real rendered cells, including the last row
                ;; and last visible column, then check the native caret.
                (dolist (offset (list 0 3 (1- (plist-get large :capacity))))
                  (let* ((target (+ (* 20 (+ first offset)) 20))
                         (pixel (tategaki-position-pixel target))
                         (top (+ (window-header-line-height) (window-tab-line-height)))
                         (hit (and pixel (posn-at-x-y (+ (plist-get pixel :x) 1)
                                                      (+ top (plist-get pixel :y) 1)))))
                    (should hit)
                    (should (>= (plist-get pixel :x) 0))
                    (should (<= (+ (plist-get pixel :x) (plist-get pixel :width))
                                (window-body-width nil t)))
                    (should (<= (+ (plist-get pixel :y) (plist-get pixel :height))
                                (window-body-height nil t)))
                    (tategaki-mouse-set-point (list 'mouse-1 hit))
                    (should (= (point) target))
                    (tategaki-rich-gui--caret)
                    (should (= tategaki--page first)))))
              (dolist (page '(2 3 4))
                (tategaki-goto-page page)
                (should (= (point) (1+ (* (1- page) 400))))
                (should (= page (plist-get (tategaki-manuscript-page-info tategaki--layout (point)) :current)))
                (tategaki-rich-gui--caret))
              (should (equal text (buffer-string)))
              (should (= tick (buffer-chars-modified-tick)))
              (should (eq undo buffer-undo-list))
              (should-not (buffer-modified-p)))))
      (set-frame-size nil width height))))

(ert-deftest tategaki-rich-gui-native-ime-preview-wraps-without-source-edit ()
  (tategaki-rich-gui--with-text "前後"
    (setq-local tategaki-column-height 3)
    (goto-char 2)
    (setq ns-working-text "日本語入力")
    (let (coordinates)
      (dotimes (index (length ns-working-text))
        (ns-put-marked-text (list 'ns-put-marked-text index 1))
        (let* ((object (tategaki-rich-gui--caret))
               (properties (text-properties-at (cdr object) (car object)))
               (pixel (tategaki-position-pixel (point))))
          (should (= (plist-get properties 'tategaki-preedit-index) index))
          (should (memq 'ns-marked-text-face (plist-get properties 'face)))
          (push (cons (plist-get pixel :x) (plist-get pixel :y)) coordinates)))
      (setq coordinates (nreverse coordinates))
      (should (= (caar coordinates) (caadr coordinates)))
      (should (< (cdar coordinates) (cdadr coordinates)))
      (should (< (car (nth 2 coordinates)) (caar coordinates))))
    (should (equal (buffer-string) "前後"))
    (should-not (buffer-modified-p))
    (should-not buffer-undo-list)))

(ert-deftest tategaki-rich-gui-header-and-tab-lines-preserve-bottom-caret ()
  (tategaki-rich-gui--with-text (make-string 1300 ?字)
    ;; Large window chrome makes the last paper row fall beyond the old
    ;; scan's body-height boundary when interpreted as posn-at-x-y input.
    (setq-local header-line-format (propertize "Header" 'face '(:height 4.0))
                tab-line-format (propertize "Tab" 'face '(:height 2.0)))
    (force-mode-line-update)
    (redisplay t)
    (tategaki-manuscript-set-preset "40x30")
    (goto-char 40)
    (tategaki-rich-gui--caret)
    (let* ((pixel (tategaki-position-pixel (point)))
           (top (+ (window-header-line-height) (window-tab-line-height))))
      (should (> (window-header-line-height) 0))
      (should (> (window-tab-line-height) 0))
      (should (> (+ top (plist-get pixel :y)) (window-body-height nil t)))
      (should (<= (+ (plist-get pixel :y) (plist-get pixel :height))
                  (window-body-height nil t))))
    (should-not (buffer-modified-p))
    (should-not buffer-undo-list)))

