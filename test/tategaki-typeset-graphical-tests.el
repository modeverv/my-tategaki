(require 'ert)
(require 'cl-lib)
(require 'package)
(package-initialize)
(let* ((directory (file-name-directory (or load-file-name buffer-file-name)))
       (root (file-name-directory (directory-file-name directory))))
  (add-to-list 'load-path root))
(setq load-prefer-newer t)
(require 'tategaki)
(require 'copilot)
(require 'corfu)
(require 'isearch)
(require 'dom)
(require 'xml)
(require 'server)
(defvar tategaki-rich-gui--directory (make-temp-file "/tmp/tategaki-rich-gui-" t))
(setq server-name "tategaki-isolated-rich-gui"
      server-socket-dir (expand-file-name "sockets" tategaki-rich-gui--directory))
(make-directory server-socket-dir t)
(set-file-modes server-socket-dir #o700)
(server-start)
(add-hook 'kill-emacs-hook
          (lambda () (ignore-errors (delete-directory tategaki-rich-gui--directory t))) t)

(defmacro tategaki-rich-gui--with-text (text &rest body)
  "Run BODY in an isolated, actually rendered rich source buffer."
  (declare (indent 1) (debug t))
  `(save-window-excursion
     (let ((source (generate-new-buffer " *Tategaki rich graphical test*"))
           (ns-working-overlay nil) (ns-working-text "") (mac-ime-hide-cursor nil)
           (copilot--overlay nil) (copilot--keymap-overlay nil)
           (corfu--preview-ov nil) (corfu--candidates nil) (corfu--base "")
           (corfu--index -1) (corfu--preselect -1) (corfu--frame nil)
           (corfu-auto nil) (corfu-preview-current t) (corfu-count 3))
       (unwind-protect
           (cl-letf (((symbol-function 'copilot--notify) #'ignore)
                     ((symbol-function 'copilot--async-request) #'ignore)
                     ((symbol-function 'copilot--cancel-completion) #'ignore))
             (switch-to-buffer source)
             (delete-other-windows)
             (text-mode)
             (insert ,text)
             (goto-char (point-min))
             (setq-local tategaki-typesetting t tategaki-column-height 6)
             (buffer-enable-undo)
             (setq buffer-undo-list nil)
             (set-buffer-modified-p nil)
             (tategaki-mode 1)
             (should (plist-get tategaki--layout :typeset))
             ,@body)
         (when (buffer-live-p source)
           (with-current-buffer source
             (ignore-errors (ns-delete-working-text))
             (ignore-errors (when completion-in-region-mode (corfu-quit)))
             (ignore-errors (corfu--preview-delete))
             (ignore-errors (tategaki-mode -1))
             (when (overlayp copilot--overlay) (delete-overlay copilot--overlay))
             (when (overlayp copilot--keymap-overlay) (delete-overlay copilot--keymap-overlay))
             (set-buffer-modified-p nil))
           (kill-buffer source))
         (when (frame-live-p corfu--frame) (delete-frame corfu--frame))))))

(defun tategaki-rich-gui--caret ()
  "Check actual cursor pixels and return its display string position."
  (tategaki-refresh)
  (redisplay t)
  (let* ((pixel (tategaki-position-pixel (point)))
         (cursor (window-cursor-info))
         (top (+ (window-header-line-height) (window-tab-line-height)))
         (position (and pixel (posn-at-x-y (+ (plist-get pixel :x) 1)
                                          (+ top (plist-get pixel :y) 1))))
         (object (and position (posn-string position))))
    (should pixel)
    (should cursor)
    (should object)
    (should (= (aref cursor 1) (plist-get pixel :x)))
    ;; Both native cursor and posn-at-x-y input include header/tab lines.
    ;; The posn-x-y result and our public pixel API exclude them, as Corfu
    ;; expects.  posn-at-x-y and posn-x-y are not inverses in such windows.
    (should (= (aref cursor 2) (+ top (plist-get pixel :y))))
    (should (= (get-text-property (cdr object) 'tategaki-virtual-position (car object))
               tategaki--caret-position))
    object))

(defun tategaki-rich-gui--image-data (object)
  "Return the SVG payload at display OBJECT."
  (let* ((display (get-text-property (cdr object) 'display (car object)))
         (image (if (eq (car-safe display) 'image) display
                  (cl-find-if (lambda (item) (eq (car-safe item) 'image)) display))))
    (and image (plist-get (cdr image) :data))))

(ert-deftest tategaki-rich-gui-cursor-and-grouped-navigation ()
  (tategaki-rich-gui--with-text "前12👩‍👩‍👧‍👧後"
    (goto-char 2)
    (tategaki-rich-gui--caret)
    (tategaki-next-character)
    (should (= (point) 4))
    (tategaki-rich-gui--caret)
    (tategaki-next-character)
    (should (= (point) 11))
    (tategaki-rich-gui--caret)
    (tategaki-previous-character)
    (should (= (point) 4))
    (tategaki-previous-character)
    (should (= (point) 2))
    ;; A native source command may stop inside a composed grapheme.
    ;; The physical Up command must return to its real source start.
    (goto-char 8)
    (tategaki-rich-gui--caret)
    (tategaki-previous-character)
    (should (= (point) 4))
    (tategaki-rich-gui--caret)
    (should-not (buffer-modified-p))))

